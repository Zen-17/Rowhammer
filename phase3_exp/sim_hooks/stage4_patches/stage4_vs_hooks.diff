+void Phase1Storage::moveCodeword(const Phase1StorageKey& from, const Phase1StorageKey& to)
+{
+    if (from.row == to.row && from.burst_column == to.burst_column &&
+        from.codeword_index == to.codeword_index && from.actual_bank == to.actual_bank &&
+        from.channel == to.channel && from.rank == to.rank)
+        return;
+    auto source = entries_.find(from);
+    auto dest = entries_.find(to);
+    if (source == entries_.end() && dest == entries_.end())
+        return;
+    if (source != entries_.end() && dest == entries_.end())
+    {
+        entries_.emplace(to, source->second);
+        entries_.erase(source);
+        return;
+    }
+    if (source == entries_.end() && dest != entries_.end())
+    {
+        entries_.emplace(from, dest->second);
+        entries_.erase(dest);
+        return;
+    }
+    std::swap(source->second, dest->second);
+}
+
 }  // namespace DRAMSim
