+        }
+        else if (placement != "SAME_BANK" && placement != "DIFF_BANK")
+            throw std::runtime_error("F1W_F4S requires SAME_BANK or DIFF_BANK");
+        if (profileName != "LOCAL_VISIBLE")
+            throw std::runtime_error("G10 smoke requires LOCAL_VISIBLE");
