+
+namespace DRAMSim
+{
+struct Phase1RunConfig
+{
+    std::string experiment;
+    std::string workload;
+    std::string mode;
+    std::string trace_mode;
+    std::string device_ini;
+    std::string system_ini;
+    unsigned channels = 0;
+    unsigned ranks = 0;
