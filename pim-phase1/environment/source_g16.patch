+                << "  \"publish_cycle\": " << runtime.publishCycle() << ",\n"
+                << "  \"recovery_cycles\": "
+                << (runtime.isPublished(newVersion) && runtime.publishCycle() >= pause.ackCycle()
+                        ? runtime.publishCycle() - pause.ackCycle()
+                        : 0) << ",\n"
+                << "  \"timeout\": false\n"
+                << "}\n";
+    }
+    catch (const std::exception& error)
+    {
+        FAIL() << "G7 case failed: " << error.what();
+    }
+}
