+                << "  \"new_published\": " << (runtime.isPublished(newVersion) ? "true" : "false")
+                << ",\n"
+                << "  \"host_read\": " << (hostRead ? "true" : "false") << ",\n"
+                << "  \"output_bit_exact\": " << (bitExact ? "true" : "false") << ",\n"
+                << "  \"caught\": "
+                << ((negativeControl != "NONE" && !bitExact && !runtime.isPublished(newVersion))
