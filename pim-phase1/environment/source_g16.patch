+BurstType corruptFirstWord(const BurstType& source, uint64_t mask)
+{
+    BurstType result = source;
+    uint64_t word = 0;
+    std::memcpy(&word, result.u8Data_, sizeof(word));
+    word ^= mask;
+    std::memcpy(result.u8Data_, &word, sizeof(word));
+    return result;
+}
