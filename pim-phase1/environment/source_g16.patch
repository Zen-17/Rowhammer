diff --git a/src/Phase1Ecc.cpp b/src/Phase1Ecc.cpp
new file mode 100644
index 0000000..2fa8f95
--- /dev/null
+++ b/src/Phase1Ecc.cpp
@@ -0,0 +1,137 @@
+#include "Phase1Ecc.h"
+
+namespace DRAMSim
+{
+namespace
+{
+constexpr unsigned kDataBits = 64;
+constexpr unsigned kCodewordBits = 72;
+
+int bitAt(const std::array<unsigned, kCodewordBits>& bits, unsigned position)
+{
+    return (position >= 1 && position <= kCodewordBits) ? static_cast<int>(bits[position - 1]) : 0;
+}
+
+void putDataBits(std::array<unsigned, kCodewordBits>& bits, uint64_t data)
+{
+    const auto& positions = Phase1Ecc::dataBitPositions();
+    for (unsigned i = 0; i < kDataBits; i++)
+        bits[positions[i] - 1] = static_cast<unsigned>((data >> i) & 1u);
+}
+
+void putParityBits(std::array<unsigned, kCodewordBits>& bits, uint8_t parity)
+{
+    const auto& positions = Phase1Ecc::hammingParityPositions();
+    for (unsigned i = 0; i < positions.size(); i++)
+        bits[positions[i] - 1] = (parity >> i) & 1u;
+    bits[71] = (parity >> 7) & 1u;
+}
+
+uint64_t extractData(const std::array<unsigned, kCodewordBits>& bits)
+{
+    const auto& positions = Phase1Ecc::dataBitPositions();
+    uint64_t data = 0;
+    for (unsigned i = 0; i < kDataBits; i++)
+        data |= static_cast<uint64_t>(bits[positions[i] - 1]) << i;
+    return data;
+}
+}  // namespace
+
+const std::array<unsigned, 7>& Phase1Ecc::hammingParityPositions()
+{
+    static const std::array<unsigned, 7> positions = {1, 2, 4, 8, 16, 32, 64};
+    return positions;
+}
+
+const std::array<unsigned, 64>& Phase1Ecc::dataBitPositions()
+{
+    static const std::array<unsigned, 64> positions = [] {
+        std::array<unsigned, 64> result{};
+        unsigned next = 0;
+        for (unsigned position = 1; position <= 71; position++)
+        {
+            if (position == 1 || position == 2 || position == 4 || position == 8 || position == 16 ||
+                position == 32 || position == 64)
+                continue;
+            result[next++] = position;
+        }
+        return result;
+    }();
+    return positions;
+}
+
+uint8_t Phase1Ecc::encodeParity(uint64_t data)
+{
+    std::array<unsigned, kCodewordBits> bits{};
+    putDataBits(bits, data);
+    const auto& parityPositions = hammingParityPositions();
+    uint8_t parity = 0;
+    for (unsigned i = 0; i < parityPositions.size(); i++)
+    {
+        const unsigned p = parityPositions[i];
+        unsigned value = 0;
+        for (unsigned position = 1; position <= 71; position++)
+        {
+            if ((position & p) != 0)
+                value ^= bits[position - 1];
+        }
+        bits[p - 1] = value;
+        parity |= static_cast<uint8_t>(value << i);
+    }
+    unsigned overall = 0;
+    for (unsigned position = 1; position <= 71; position++)
+        overall ^= bits[position - 1];
+    bits[71] = overall;
+    parity |= static_cast<uint8_t>(overall << 7);
+    return parity;
+}
+
+Phase1EccResult Phase1Ecc::decode(uint64_t data, uint8_t parity)
+{
+    std::array<unsigned, kCodewordBits> bits{};
+    putDataBits(bits, data);
+    putParityBits(bits, parity);
+
+    unsigned syndrome = 0;
+    for (unsigned position = 1; position <= 71; position++)
+        if (bitAt(bits, position) != 0)
+            syndrome ^= position;
+    unsigned overall = 0;
+    for (unsigned position = 1; position <= 72; position++)
+        overall ^= static_cast<unsigned>(bitAt(bits, position));
+
+    Phase1EccResult result;
+    result.data = data;
+    result.syndrome = syndrome;
+    result.overall_parity = overall;
+
+    if (syndrome == 0 && overall == 0)
+    {
+        result.status = Phase1EccStatus::CLEAN;
+        return result;
+    }
+    if (syndrome == 0 && overall == 1)
+    {
+        // Only the position-72 overall parity bit is wrong.
+        result.status = Phase1EccStatus::CORRECTED;
+        return result;
+    }
+    if (syndrome != 0 && overall == 1 && syndrome <= 71)
+    {
+        // Correct the single position indicated by the syndrome.  If the
+        // position is a Hamming parity bit, the data bits are unchanged.
+        bits[syndrome - 1] ^= 1u;
+        result.data = extractData(bits);
+        result.status = Phase1EccStatus::CORRECTED;
+        return result;
+    }
+    if (syndrome > 71 && overall == 1)
+    {
+        result.status = Phase1EccStatus::INVALID;
+        return result;
+    }
+    result.status = Phase1EccStatus::UNCORRECTABLE;
+    return result;
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Ecc.h b/src/Phase1Ecc.h
new file mode 100644
index 0000000..4d997ad
--- /dev/null
+++ b/src/Phase1Ecc.h
@@ -0,0 +1,48 @@
+#ifndef PHASE1_ECC_H
+#define PHASE1_ECC_H
+
+#include <array>
+#include <cstdint>
+
+namespace DRAMSim
+{
+enum class Phase1EccStatus
+{
+    CLEAN,
+    CORRECTED,
+    UNCORRECTABLE,
+    INVALID,
+    UNPROTECTED_FORMAT
+};
+
+struct Phase1EccResult
+{
+    uint64_t data = 0;
+    Phase1EccStatus status = Phase1EccStatus::CLEAN;
+    unsigned syndrome = 0;
+    unsigned overall_parity = 0;
+};
+
+// Explicit extended Hamming SECDED(72,64) research model.
+//
+// Codeword positions are 1..72:
+//   1,2,4,8,16,32,64 -> Hamming parity
+//   other 1..71      -> data bits 0..63 in ascending position order
+//   72               -> overall even parity over positions 1..71
+//
+// The 8-bit parity byte uses bit 0..6 for the Hamming parity positions
+// 1,2,4,8,16,32,64 and bit 7 for the position-72 overall parity bit.  This
+// layout is a Phase1 model choice, not a claim about a commercial HBM ECC
+// codeword layout.
+class Phase1Ecc
+{
+  public:
+    static uint8_t encodeParity(uint64_t data);
+    static Phase1EccResult decode(uint64_t data, uint8_t parity);
+
+    static const std::array<unsigned, 7>& hammingParityPositions();
+    static const std::array<unsigned, 64>& dataBitPositions();
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Feeder.cpp b/src/Phase1Feeder.cpp
new file mode 100644
index 0000000..02f6516
--- /dev/null
+++ b/src/Phase1Feeder.cpp
@@ -0,0 +1,396 @@
+#include "Phase1Feeder.h"
+
+#include <algorithm>
+#include <stdexcept>
+
+#include "Phase1Trace.h"
+
+namespace DRAMSim
+{
+namespace
+{
+bool isPimBroadcastTag(const std::string& tag)
+{
+    return tag == "BANK_TO_GRF_" || tag == "ADD" || tag == "GRF_TO_BANK" ||
+           tag == "FILL&ReLU" || tag == "GRF_A_TO_EVEN_BANK" || tag == "GRF_B_TO_ODD_BANK" ||
+           tag == "MAC_" || tag == "GRF_B_TO_BANK_" || tag == "RESET_GRF_B";
+}
+}  // namespace
+
+Phase1FeederMemory::Phase1FeederMemory(const std::string& deviceIniFilename,
+                                       const std::string& systemIniFilename,
+                                       const std::string& pwd, const std::string& traceFilename,
+                                       unsigned megsOfMemory, unsigned outstandingLimit)
+    : MultiChannelMemorySystem(deviceIniFilename, systemIniFilename, pwd, traceFilename,
+                               megsOfMemory),
+      outstanding_limit_(outstandingLimit)
+{
+    if (outstanding_limit_ == 0)
+        throw std::invalid_argument("feeder outstanding limit must be non-zero");
+    outstanding_.assign(channels.size(), 0);
+    frozen_.assign(channels.size(), false);
+    read_callback_.reset(
+        new Callback<Phase1FeederMemory, void, unsigned, uint64_t, uint64_t>(
+            this, &Phase1FeederMemory::onReadComplete));
+    write_callback_.reset(
+        new Callback<Phase1FeederMemory, void, unsigned, uint64_t, uint64_t>(
+            this, &Phase1FeederMemory::onWriteComplete));
+    RegisterCallbacks(read_callback_.get(), write_callback_.get(), nullptr);
+}
+
+bool Phase1FeederMemory::addTransaction(Transaction* trans)
+{
+    if (trans == nullptr)
+        return false;
+    const bool isWrite = (trans->transactionType == DATA_WRITE);
+    if (trans->transactionType != DATA_WRITE && trans->transactionType != DATA_READ)
+    {
+        delete trans;
+        return false;
+    }
+    const bool queued = enqueue(isWrite, trans->address, trans->tag, trans->data);
+    delete trans;
+    return queued;
+}
+
+bool Phase1FeederMemory::addTransaction(bool isWrite, uint64_t addr, BurstType* data)
+{
+    return enqueue(isWrite, addr, "", data);
+}
+
+bool Phase1FeederMemory::addTransaction(bool isWrite, uint64_t addr, const std::string& tag,
+                                        BurstType* data)
+{
+    return enqueue(isWrite, addr, tag, data);
+}
+
+bool Phase1FeederMemory::addBarrier(int chanId)
+{
+    if (chanId < 0 || static_cast<size_t>(chanId) >= channels.size())
+        throw std::out_of_range("feeder barrier channel out of range");
+    auto item = std::unique_ptr<Item>(new Item());
+    item->kind = Item::Kind::BARRIER;
+    item->channel = static_cast<unsigned>(chanId);
+    item->sequence = next_sequence_++;
+    const uint64_t sequence = item->sequence;
+    pending_.push_back(std::move(item));
+    max_pending_ = std::max(max_pending_, pending_.size());
+    if (trace_ != nullptr)
+        trace_->event(currentClockCycle, "ENQUEUE", "BARRIER_ENQUEUE", "1", "1",
+                      std::to_string(sequence), -1, -1, -1, -1, -1, "", -1, "queued");
+    return true;
+}
+
+void Phase1FeederMemory::decodeAddress(uint64_t address, unsigned& channel, unsigned& rank,
+                                       unsigned& bank, unsigned& row, unsigned& column) const
+{
+    addrMapping->addressMapping(address, channel, rank, bank, row, column);
+    if (channel >= channels.size())
+        throw std::out_of_range("feeder address maps outside channel range");
+}
+
+bool Phase1FeederMemory::enqueue(bool isWrite, uint64_t address, const std::string& tag,
+                                 BurstType* data)
+{
+    if (data == nullptr)
+        throw std::invalid_argument("feeder transaction has null payload/buffer");
+    auto item = std::unique_ptr<Item>(new Item());
+    item->kind = Item::Kind::TRANSACTION;
+    item->is_write = isWrite;
+    item->address = address;
+    decodeAddress(address, item->channel, item->rank, item->bank, item->row, item->column);
+    item->tag = tag;
+    item->access_path = tag;
+    if (tag == "PROGRAM_CRF" || tag == "PIM")
+    {
+        item->location = Item::LocationKind::PIM_CONTROL;
+        item->access_path = tag + ":PIM_CONTROL";
+    }
+    else if (isPimBroadcastTag(tag))
+    {
+        item->location = Item::LocationKind::PIM_BROADCAST;
+        item->access_path = tag + ":PIM_BROADCAST";
+    }
+    if (isWrite)
+        item->payload = *data;  // stable ownership of the write payload
+    else
+        item->read_buffer = data;  // caller-owned receive buffer, kept alive by caller
+    item->sequence = next_sequence_++;
+    traceItem(*item, "ENQUEUE", "DESCRIPTOR_ENQUEUE", "queued");
+    pending_.push_back(std::move(item));
+    max_pending_ = std::max(max_pending_, pending_.size());
+    return true;
+}
+
+void Phase1FeederMemory::traceItem(const Item& item, const std::string& phase,
+                                   const std::string& eventType, const std::string& status,
+                                   int cycleOffset) const
+{
+    if (trace_ == nullptr)
+        return;
+    const int64_t cycle = static_cast<int64_t>(currentClockCycle) + cycleOffset;
+    const bool hasBank = item.location == Item::LocationKind::NORMAL;
+    const bool hasRowCol = item.location != Item::LocationKind::PIM_CONTROL;
+    trace_->event(cycle < 0 ? 0 : static_cast<uint64_t>(cycle), phase, eventType, "1", "1",
+                  std::to_string(item.sequence), static_cast<int>(item.channel),
+                  static_cast<int>(item.rank), hasBank ? static_cast<int>(item.bank) : -1,
+                  hasRowCol ? static_cast<int>(item.row) : -1,
+                  hasRowCol ? static_cast<int>(item.column) : -1, item.access_path, 32, status);
+}
+
+void Phase1FeederMemory::traceNoItem(const std::string& phase, const std::string& eventType,
+                                     const std::string& status, int cycleOffset) const
+{
+    if (trace_ == nullptr)
+        return;
+    const int64_t cycle = static_cast<int64_t>(currentClockCycle) + cycleOffset;
+    trace_->event(cycle < 0 ? 0 : static_cast<uint64_t>(cycle), phase, eventType, "1", "1", "", -1,
+                  -1, -1, -1, -1, "", -1, status);
+}
+
+bool Phase1FeederMemory::barrierReady(unsigned channel) const
+{
+    if (channel >= outstanding_.size() || outstanding_[channel] != 0)
+        return false;
+    if (MultiChannelMemorySystem::hasPendingTransactions() != 0)
+        return false;
+    return rankAndControllerIdle();
+}
+
+bool Phase1FeederMemory::rankAndControllerIdle() const
+{
+    for (size_t c = 0; c < channels.size(); c++)
+    {
+        const MemorySystem* memory = channels[c];
+        if (memory == nullptr)
+            return false;
+        if (!memory->pendingTransactions.empty())
+            return false;
+        if (memory->memoryController == nullptr ||
+            !memory->memoryController->transactionQueue.empty())
+            return false;
+        if (memory->ranks == nullptr)
+            return false;
+        for (Rank* rank : *memory->ranks)
+        {
+            if (rank == nullptr || rank->outgoingDataPacket != nullptr ||
+                !rank->readReturnPacket.empty() || !rank->readReturnCountdown.empty())
+                return false;
+        }
+    }
+    return true;
+}
+
+bool Phase1FeederMemory::tick()
+{
+    if (pending_.empty())
+        return false;
+
+    Item& front = *pending_.front();
+    if (front.channel < frozen_.size() && frozen_[front.channel])
+        return false;
+    if (front.kind == Item::Kind::BARRIER)
+    {
+        if (!barrierReady(front.channel))
+            return false;
+        // With no accepted transaction left, the upstream barrier has nothing
+        // to attach to; the conservative feeder order already guarantees the
+        // prior stage is quiesced.
+        MultiChannelMemorySystem::addBarrier(static_cast<int>(front.channel));
+        traceNoItem("FEEDER", "BARRIER_RETIRED", "retired");
+        pending_.pop_front();
+        barriers_retired_++;
+        return true;
+    }
+
+    const unsigned channel = front.channel;
+    if (channel >= outstanding_.size())
+        throw std::out_of_range("feeder channel out of range");
+    if (outstanding_[channel] >= outstanding_limit_)
+        return false;
+    if (!MultiChannelMemorySystem::willAcceptTransaction(front.address))
+    {
+        controller_rejections_++;
+        traceItem(front, "FEEDER", "CONTROLLER_REJECT", "rejected");
+        return false;
+    }
+
+    BurstType* data = front.is_write ? &front.payload : front.read_buffer;
+    if (data == nullptr)
+        throw std::logic_error("feeder transaction has no data pointer");
+    if (!MultiChannelMemorySystem::addTransaction(front.is_write, front.address, front.tag, data))
+    {
+        controller_rejections_++;
+        traceItem(front, "FEEDER", "CONTROLLER_REJECT", "rejected");
+        return false;
+    }
+
+    outstanding_[channel]++;
+    max_outstanding_ = std::max(max_outstanding_, outstandingCount());
+    traceItem(front, "FEEDER", "CONTROLLER_ACCEPT", "accepted");
+    if (trace_ != nullptr && trace_->enabled())
+    {
+        CompletionRecord record;
+        record.sequence = front.sequence;
+        record.location = front.location;
+        record.access_path = front.access_path;
+        completion_ids_.insert(std::make_pair(front.address, record));
+    }
+    accepted_.push_back(std::move(pending_.front()));
+    pending_.pop_front();
+    return true;
+}
+
+bool Phase1FeederMemory::tickChannel(unsigned channel)
+{
+    if (channel >= outstanding_.size() || frozen_[channel])
+        return false;
+    for (auto it = pending_.begin(); it != pending_.end(); ++it)
+    {
+        Item& item = **it;
+        if (item.channel != channel)
+            continue;
+        if (item.kind == Item::Kind::BARRIER)
+            return false;  // barrier handling is only through tick()
+        if (outstanding_[channel] >= outstanding_limit_)
+            return false;
+        if (!MultiChannelMemorySystem::willAcceptTransaction(item.address))
+        {
+            controller_rejections_++;
+            traceItem(item, "FEEDER", "CONTROLLER_REJECT", "rejected");
+            return false;
+        }
+        BurstType* data = item.is_write ? &item.payload : item.read_buffer;
+        if (data == nullptr)
+            throw std::logic_error("feeder transaction has no data pointer");
+        if (!MultiChannelMemorySystem::addTransaction(item.is_write, item.address, item.tag, data))
+        {
+            controller_rejections_++;
+            traceItem(item, "FEEDER", "CONTROLLER_REJECT", "rejected");
+            return false;
+        }
+        outstanding_[channel]++;
+        max_outstanding_ = std::max(max_outstanding_, outstandingCount());
+        traceItem(item, "FEEDER", "CONTROLLER_ACCEPT", "accepted");
+        if (trace_ != nullptr && trace_->enabled())
+        {
+            CompletionRecord record;
+            record.sequence = item.sequence;
+            record.location = item.location;
+            record.access_path = item.access_path;
+            completion_ids_.insert(std::make_pair(item.address, record));
+        }
+        accepted_.push_back(std::move(*it));
+        pending_.erase(it);
+        return true;
+    }
+    return false;
+}
+
+void Phase1FeederMemory::freezeChannel(unsigned channel)
+{
+    if (channel >= frozen_.size())
+        throw std::out_of_range("feeder freeze channel out of range");
+    frozen_[channel] = true;
+}
+
+void Phase1FeederMemory::unfreezeChannel(unsigned channel)
+{
+    if (channel >= frozen_.size())
+        throw std::out_of_range("feeder unfreeze channel out of range");
+    frozen_[channel] = false;
+}
+
+std::size_t Phase1FeederMemory::clearPending()
+{
+    const std::size_t count = pending_.size();
+    pending_.clear();
+    return count;
+}
+
+bool Phase1FeederMemory::isFrozen(unsigned channel) const
+{
+    return channel < frozen_.size() && frozen_[channel];
+}
+
+bool Phase1FeederMemory::channelIdle(unsigned channel) const
+{
+    if (channel >= outstanding_.size() || outstanding_[channel] != 0)
+        return false;
+    const MemorySystem* memory = channels[channel];
+    if (memory == nullptr || !memory->pendingTransactions.empty())
+        return false;
+    if (memory->memoryController == nullptr ||
+        !memory->memoryController->transactionQueue.empty())
+        return false;
+    if (memory->ranks == nullptr)
+        return false;
+    for (const Rank* rank : *memory->ranks)
+        if (rank == nullptr || rank->outgoingDataPacket != nullptr ||
+            !rank->readReturnPacket.empty() || !rank->readReturnCountdown.empty())
+            return false;
+    return true;
+}
+
+bool Phase1FeederMemory::isIdle() const
+{
+    if (!pending_.empty() || outstandingCount() != 0)
+        return false;
+    if (MultiChannelMemorySystem::hasPendingTransactions() != 0)
+        return false;
+    return rankAndControllerIdle();
+}
+
+std::size_t Phase1FeederMemory::outstandingCount() const
+{
+    std::size_t total = 0;
+    for (unsigned value : outstanding_)
+        total += value;
+    return total;
+}
+
+void Phase1FeederMemory::onReadComplete(unsigned systemID, uint64_t address, uint64_t cycle)
+{
+    (void)cycle;
+    if (systemID < outstanding_.size() && outstanding_[systemID] > 0)
+        outstanding_[systemID]--;
+    if (trace_ != nullptr && trace_->enabled())
+    {
+        auto found = completion_ids_.find(address);
+        if (found != completion_ids_.end())
+        {
+            Item item;
+            item.address = address;
+            item.sequence = found->second.sequence;
+            item.location = found->second.location;
+            item.access_path = found->second.access_path;
+            decodeAddress(address, item.channel, item.rank, item.bank, item.row, item.column);
+            traceItem(item, "COMPLETE", "READ_COMPLETE", "completed");
+            completion_ids_.erase(found);
+        }
+    }
+}
+
+void Phase1FeederMemory::onWriteComplete(unsigned systemID, uint64_t address, uint64_t cycle)
+{
+    (void)cycle;
+    if (systemID < outstanding_.size() && outstanding_[systemID] > 0)
+        outstanding_[systemID]--;
+    if (trace_ != nullptr && trace_->enabled())
+    {
+        auto found = completion_ids_.find(address);
+        if (found != completion_ids_.end())
+        {
+            Item item;
+            item.address = address;
+            item.sequence = found->second.sequence;
+            item.location = found->second.location;
+            item.access_path = found->second.access_path;
+            decodeAddress(address, item.channel, item.rank, item.bank, item.row, item.column);
+            traceItem(item, "COMPLETE", "WRITE_DATA_DONE", "data_bus_done");
+            completion_ids_.erase(found);
+        }
+    }
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Feeder.h b/src/Phase1Feeder.h
new file mode 100644
index 0000000..8d1e42c
--- /dev/null
+++ b/src/Phase1Feeder.h
@@ -0,0 +1,134 @@
+#ifndef PHASE1_FEEDER_H
+#define PHASE1_FEEDER_H
+
+#include <cstddef>
+#include <cstdint>
+#include <list>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "Callback.h"
+#include "MultiChannelMemorySystem.h"
+
+namespace DRAMSim
+{
+class Phase1Trace;
+
+// Experimental bounded transaction feeder.
+//
+// This is a Phase1 interface model: it does not claim that a real HBM-PIM
+// controller exposes a corresponding external submission queue.  The class
+// keeps the external pending queue separate from the accepted/in-flight
+// transactions counted by the upstream simulator.
+class Phase1FeederMemory : public MultiChannelMemorySystem
+{
+  public:
+    Phase1FeederMemory(const std::string& deviceIniFilename,
+                       const std::string& systemIniFilename, const std::string& pwd,
+                       const std::string& traceFilename, unsigned megsOfMemory,
+                       unsigned outstandingLimit = 8);
+
+    bool addTransaction(Transaction* trans) override;
+    bool addTransaction(bool isWrite, uint64_t addr, BurstType* data) override;
+    bool addTransaction(bool isWrite, uint64_t addr, const std::string& tag,
+                        BurstType* data) override;
+    bool addBarrier(int chanId) override;
+
+    // Submit at most one external item.  Returns true iff an item was
+    // submitted/consumed or a barrier was retired.
+    bool tick();
+    // Submit at most one external item for a specific channel.  Used by the
+    // two-channel pause smoke; per-channel order is retained.
+    bool tickChannel(unsigned channel);
+
+    void freezeChannel(unsigned channel);
+    void unfreezeChannel(unsigned channel);
+    // G7 discard of old uncommitted external descriptors.  Accepted/in-flight
+    // transactions must already be drained by quiesce.
+    std::size_t clearPending();
+    bool isFrozen(unsigned channel) const;
+    bool channelIdle(unsigned channel) const;
+
+    bool isIdle() const;
+    std::size_t pendingCount() const { return pending_.size(); }
+    std::size_t acceptedCount() const { return accepted_.size(); }
+    std::size_t outstandingCount() const;
+    std::size_t maxPending() const { return max_pending_; }
+    std::size_t maxOutstanding() const { return max_outstanding_; }
+    uint64_t controllerRejections() const { return controller_rejections_; }
+    uint64_t barriersRetired() const { return barriers_retired_; }
+
+    void setTrace(Phase1Trace* trace) { trace_ = trace; }
+
+    // Callbacks are installed on each upstream MemorySystem.  They are used
+    // only for the feeder's own accounting; they do not alter runtime state.
+    void onReadComplete(unsigned systemID, uint64_t address, uint64_t cycle);
+    void onWriteComplete(unsigned systemID, uint64_t address, uint64_t cycle);
+
+  private:
+    struct Item
+    {
+        enum class Kind
+        {
+            TRANSACTION,
+            BARRIER
+        };
+        enum class LocationKind
+        {
+            NORMAL,
+            PIM_BROADCAST,
+            PIM_CONTROL
+        };
+        Kind kind = Kind::TRANSACTION;
+        bool is_write = false;
+        uint64_t address = 0;
+        unsigned channel = 0;
+        unsigned rank = 0;
+        unsigned bank = 0;
+        unsigned row = 0;
+        unsigned column = 0;
+        LocationKind location = LocationKind::NORMAL;
+        std::string tag;
+        std::string access_path;
+        BurstType payload;           // stable copy for writes
+        BurstType* read_buffer = nullptr;  // caller-owned receive buffer
+        uint64_t sequence = 0;
+    };
+
+    struct CompletionRecord
+    {
+        uint64_t sequence = 0;
+        Item::LocationKind location = Item::LocationKind::NORMAL;
+        std::string access_path;
+    };
+
+    bool enqueue(bool isWrite, uint64_t address, const std::string& tag, BurstType* data);
+    void decodeAddress(uint64_t address, unsigned& channel, unsigned& rank, unsigned& bank,
+                       unsigned& row, unsigned& column) const;
+    bool barrierReady(unsigned channel) const;
+    bool rankAndControllerIdle() const;
+    void traceItem(const Item& item, const std::string& phase, const std::string& eventType,
+                   const std::string& status, int cycleOffset = 0) const;
+    void traceNoItem(const std::string& phase, const std::string& eventType,
+                     const std::string& status, int cycleOffset = 0) const;
+
+    std::list<std::unique_ptr<Item>> pending_;
+    std::list<std::unique_ptr<Item>> accepted_;
+    std::vector<unsigned> outstanding_;
+    std::vector<bool> frozen_;
+    unsigned outstanding_limit_ = 8;
+    uint64_t next_sequence_ = 0;
+    uint64_t controller_rejections_ = 0;
+    uint64_t barriers_retired_ = 0;
+    std::size_t max_pending_ = 0;
+    std::size_t max_outstanding_ = 0;
+    Phase1Trace* trace_ = nullptr;
+    std::multimap<uint64_t, CompletionRecord> completion_ids_;
+    std::unique_ptr<TransactionCompleteCB> read_callback_;
+    std::unique_ptr<TransactionCompleteCB> write_callback_;
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Pause.cpp b/src/Phase1Pause.cpp
new file mode 100644
index 0000000..c843ffd
--- /dev/null
+++ b/src/Phase1Pause.cpp
@@ -0,0 +1,47 @@
+#include "Phase1Pause.h"
+
+#include <stdexcept>
+
+namespace DRAMSim
+{
+Phase1PauseController::Phase1PauseController(Phase1FeederMemory& feeder, unsigned channel,
+                                             uint64_t handlerDelay)
+    : feeder_(feeder), channel_(channel), handler_delay_(handlerDelay)
+{
+    if (channel_ >= feeder_.channels.size())
+        throw std::out_of_range("pause channel out of range");
+}
+
+void Phase1PauseController::request(uint64_t cycle, const std::string& reason)
+{
+    if (requested_)
+        return;
+    requested_ = true;
+    request_cycle_ = cycle;
+    reason_ = reason;
+    feeder_.freezeChannel(channel_);
+}
+
+void Phase1PauseController::notifyReport(uint64_t reportCycle)
+{
+    if (requested_ || scheduled_)
+        return;
+    scheduled_ = true;
+    scheduled_cycle_ = reportCycle + handler_delay_;
+    reason_ = "REPORT_TRIGGERED";
+}
+
+void Phase1PauseController::tick(uint64_t cycle)
+{
+    if (scheduled_ && !requested_ && cycle >= scheduled_cycle_)
+    {
+        scheduled_ = false;
+        request(cycle, reason_);
+    }
+    if (requested_ && !acked_ && feeder_.channelIdle(channel_))
+    {
+        acked_ = true;
+        ack_cycle_ = cycle;
+    }
+}
+}  // namespace DRAMSim
diff --git a/src/Phase1Pause.h b/src/Phase1Pause.h
new file mode 100644
index 0000000..2e2a257
--- /dev/null
+++ b/src/Phase1Pause.h
@@ -0,0 +1,48 @@
+#ifndef PHASE1_PAUSE_H
+#define PHASE1_PAUSE_H
+
+#include <cstdint>
+#include <string>
+
+#include "Phase1Feeder.h"
+
+namespace DRAMSim
+{
+// G6 channel quiesce controller.  It stops new feeder submissions for the
+// target channel, waits for accepted transactions to drain, and reports ACK.
+// It deliberately does not stop the DRAM clock, refresh, or other channels.
+class Phase1PauseController
+{
+  public:
+    Phase1PauseController(Phase1FeederMemory& feeder, unsigned channel,
+                          uint64_t handlerDelay = 0);
+
+    void request(uint64_t cycle, const std::string& reason = "SYNTHETIC_CONTROL");
+    void notifyReport(uint64_t reportCycle);
+    void tick(uint64_t cycle);
+
+    bool requested() const { return requested_; }
+    bool acked() const { return acked_; }
+    bool scheduled() const { return scheduled_; }
+    unsigned channel() const { return channel_; }
+    const std::string& reason() const { return reason_; }
+    uint64_t requestCycle() const { return request_cycle_; }
+    uint64_t ackCycle() const { return ack_cycle_; }
+    uint64_t quiesceCycles() const { return ack_cycle_ - request_cycle_; }
+    uint64_t scheduledCycle() const { return scheduled_cycle_; }
+
+  private:
+    Phase1FeederMemory& feeder_;
+    unsigned channel_ = 0;
+    uint64_t handler_delay_ = 0;
+    bool requested_ = false;
+    bool acked_ = false;
+    bool scheduled_ = false;
+    std::string reason_;
+    uint64_t scheduled_cycle_ = 0;
+    uint64_t request_cycle_ = 0;
+    uint64_t ack_cycle_ = 0;
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Profile.h b/src/Phase1Profile.h
new file mode 100644
index 0000000..40433db
--- /dev/null
+++ b/src/Phase1Profile.h
@@ -0,0 +1,31 @@
+#ifndef PHASE1_PROFILE_H
+#define PHASE1_PROFILE_H
+
+namespace DRAMSim
+{
+enum class Phase1Profile
+{
+    NATIVE,
+    LOCAL_VISIBLE,
+    LOCAL_HIDDEN,
+    HOST_ONLY
+};
+
+enum class Phase1AccessType
+{
+    HOST,
+    PIM_OPERAND,
+    PIM_RESULT,
+    HAB
+};
+
+enum class Phase1PacketStatus
+{
+    OK = 0,
+    CORRECTED = 1,
+    UNPROTECTED_FORMAT = 2,
+    UNCORRECTABLE = 3
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Reports.cpp b/src/Phase1Reports.cpp
new file mode 100644
index 0000000..78ce6f6
--- /dev/null
+++ b/src/Phase1Reports.cpp
@@ -0,0 +1,135 @@
+#include "Phase1Reports.h"
+
+#include <algorithm>
+#include <fstream>
+#include <stdexcept>
+
+namespace DRAMSim
+{
+Phase1Reports::Phase1Reports(const Phase1Address& address, unsigned num_channels,
+                             unsigned num_banks, const std::string& granularity,
+                             uint64_t transport_delay, uint64_t service_interval, unsigned capacity,
+                             bool deliver_ce, bool deliver_ue)
+    : address_(address),
+      num_channels_(num_channels),
+      num_banks_(num_banks),
+      granularity_(granularity),
+      transport_delay_(transport_delay),
+      service_interval_(std::max<uint64_t>(1, service_interval)),
+      capacity_(capacity),
+      deliver_ce_(deliver_ce),
+      deliver_ue_(deliver_ue)
+{
+    if (granularity_ != "bank" && granularity_ != "page" && granularity_ != "codeword")
+        throw std::invalid_argument("report granularity must be bank, page or codeword");
+    if (capacity_ == 0)
+        throw std::invalid_argument("report queue capacity must be non-zero");
+}
+
+void Phase1Reports::onDetected(const Phase1Detection& detection)
+{
+    if (detection.status != Phase1EccStatus::CORRECTED &&
+        detection.status != Phase1EccStatus::UNCORRECTABLE)
+        return;
+
+    internal_detections_++;
+    const bool is_ce = (detection.status == Phase1EccStatus::CORRECTED);
+    if (is_ce)
+        internal_ce_++;
+    else
+        internal_ue_++;
+    if ((is_ce && !deliver_ce_) || (!is_ce && !deliver_ue_))
+        return;
+
+    Pending item;
+    item.detect_cycle = detection.detect_cycle;
+    item.ready_cycle = detection.detect_cycle + std::max<uint64_t>(1, transport_delay_);
+    item.arrival_seq = next_arrival_seq_++;
+    item.error_class = is_ce ? "CE" : "UE";
+
+    Phase1AddrTuple tuple;
+    tuple.channel = detection.channel;
+    tuple.rank = detection.rank;
+    tuple.bank = detection.actual_bank;
+    tuple.row = detection.row;
+    tuple.burst_column = detection.burst_column;
+    if (granularity_ == "bank")
+    {
+        item.region_type = "bank";
+        item.region_id = static_cast<uint64_t>(detection.channel) * num_banks_ +
+                         detection.actual_bank;
+    }
+    else if (granularity_ == "page")
+    {
+        item.region_type = "page";
+        const uint64_t hostAddress = address_.encode(tuple);
+        item.region_id = hostAddress / 4096ULL;
+    }
+    else
+    {
+        // ASSUMED codeword-granularity interface.  Deterministic linear
+        // encoding of (channel, actual_bank, row, burst_column, codeword):
+        //   (((channel * num_banks + bank) * num_rows + row) * burst_columns
+        //     + burst_column) * 4 + codeword_index
+        const Phase1Geometry& geometry = address_.geometry();
+        item.region_type = "codeword";
+        item.region_id =
+            (((static_cast<uint64_t>(detection.channel) * num_banks_ +
+               detection.actual_bank) *
+                  geometry.num_rows +
+              detection.row) *
+                 geometry.burst_columns() +
+             detection.burst_column) *
+                4ULL +
+            detection.codeword_index;
+    }
+
+    if (pending_.size() >= capacity_)
+    {
+        dropped_++;
+        overflow_ = true;
+        return;
+    }
+    pending_.push_back(item);
+    max_queue_depth_ = std::max(max_queue_depth_, pending_.size());
+}
+
+void Phase1Reports::onUnprotectedFormat(const Phase1FormatEvent& event)
+{
+    (void)event;
+    format_events_++;
+}
+
+void Phase1Reports::tick(uint64_t cycle)
+{
+    if (pending_.empty())
+        return;
+    const Pending& front = pending_.front();
+    if (cycle < front.ready_cycle || cycle < next_service_cycle_)
+        return;
+
+    Phase1PublicReport report;
+    report.report_seq = next_report_seq_++;
+    report.report_cycle = cycle;
+    report.error_class = front.error_class;
+    report.region_type = front.region_type;
+    report.region_id = front.region_id;
+    reports_.push_back(report);
+    latencies_.push_back(cycle - front.detect_cycle);
+    delivered_++;
+    next_service_cycle_ = cycle + service_interval_;
+    pending_.pop_front();
+}
+
+void Phase1Reports::writeCsv(const std::string& path) const
+{
+    std::ofstream output(path, std::ios::out | std::ios::trunc);
+    if (!output)
+        throw std::runtime_error("cannot open reports.csv: " + path);
+    output << "report_seq,report_cycle,error_class,region_type,region_id\n";
+    for (const Phase1PublicReport& report : reports_)
+        output << report.report_seq << ',' << report.report_cycle << ',' << report.error_class << ','
+               << report.region_type << ',' << report.region_id << '\n';
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Reports.h b/src/Phase1Reports.h
new file mode 100644
index 0000000..a6bee4b
--- /dev/null
+++ b/src/Phase1Reports.h
@@ -0,0 +1,126 @@
+#ifndef PHASE1_REPORTS_H
+#define PHASE1_REPORTS_H
+
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <vector>
+
+#include "Phase1Address.h"
+#include "Phase1Ecc.h"
+#include "Phase1Profile.h"
+
+namespace DRAMSim
+{
+struct Phase1Detection
+{
+    uint64_t detect_cycle = 0;
+    unsigned channel = 0;
+    unsigned rank = 0;
+    unsigned actual_bank = 0;
+    unsigned row = 0;
+    unsigned burst_column = 0;
+    unsigned codeword_index = 0;
+    Phase1EccStatus status = Phase1EccStatus::CLEAN;
+    Phase1AccessType access = Phase1AccessType::HOST;
+};
+
+struct Phase1FormatEvent
+{
+    uint64_t detect_cycle = 0;
+    unsigned channel = 0;
+    unsigned rank = 0;
+    unsigned actual_bank = 0;
+    unsigned row = 0;
+    unsigned burst_column = 0;
+    unsigned codeword_index = 0;
+    Phase1AccessType access = Phase1AccessType::HOST;
+};
+
+struct Phase1PublicReport
+{
+    uint64_t report_seq = 0;
+    uint64_t report_cycle = 0;
+    std::string error_class;
+    std::string region_type;
+    uint64_t region_id = 0;
+};
+
+class Phase1ReportSink
+{
+  public:
+    virtual ~Phase1ReportSink() {}
+    virtual void onDetected(const Phase1Detection& detection) = 0;
+    virtual void onUnprotectedFormat(const Phase1FormatEvent& event) = 0;
+};
+
+// Coarse report queue.  It has no reference to runtime, golden output or fault
+// schedules.  The CSV contains only the public fields; detect_cycle remains
+// internal and is used only for latency accounting in the test harness.
+class Phase1Reports : public Phase1ReportSink
+{
+  public:
+    Phase1Reports(const Phase1Address& address, unsigned num_channels, unsigned num_banks,
+                  const std::string& granularity, uint64_t transport_delay,
+                  uint64_t service_interval, unsigned capacity, bool deliver_ce,
+                  bool deliver_ue);
+
+    void onDetected(const Phase1Detection& detection) override;
+    void onUnprotectedFormat(const Phase1FormatEvent& event) override;
+
+    // Deliver at most one due report at this cycle.  Call once per DRAM cycle.
+    void tick(uint64_t cycle);
+    void writeCsv(const std::string& path) const;
+
+    const std::vector<Phase1PublicReport>& reports() const { return reports_; }
+    const std::vector<uint64_t>& reportLatencies() const { return latencies_; }
+    std::size_t pendingCount() const { return pending_.size(); }
+    uint64_t internalDetections() const { return internal_detections_; }
+    uint64_t internalCe() const { return internal_ce_; }
+    uint64_t internalUe() const { return internal_ue_; }
+    uint64_t delivered() const { return delivered_; }
+    uint64_t dropped() const { return dropped_; }
+    uint64_t formatEvents() const { return format_events_; }
+    bool overflow() const { return overflow_; }
+    std::size_t maxQueueDepth() const { return max_queue_depth_; }
+    std::size_t droppedReports() const { return dropped_; }
+
+  private:
+    struct Pending
+    {
+        uint64_t detect_cycle = 0;
+        uint64_t ready_cycle = 0;
+        uint64_t arrival_seq = 0;
+        std::string error_class;
+        std::string region_type;
+        uint64_t region_id = 0;
+    };
+
+    Phase1Address address_;
+    unsigned num_channels_ = 0;
+    unsigned num_banks_ = 0;
+    std::string granularity_;
+    uint64_t transport_delay_ = 0;
+    uint64_t service_interval_ = 1;
+    unsigned capacity_ = 64;
+    bool deliver_ce_ = true;
+    bool deliver_ue_ = true;
+
+    std::deque<Pending> pending_;
+    std::vector<Phase1PublicReport> reports_;
+    std::vector<uint64_t> latencies_;
+    uint64_t next_service_cycle_ = 0;
+    uint64_t next_report_seq_ = 1;
+    uint64_t next_arrival_seq_ = 1;
+    uint64_t internal_detections_ = 0;
+    uint64_t internal_ce_ = 0;
+    uint64_t internal_ue_ = 0;
+    uint64_t delivered_ = 0;
+    uint64_t dropped_ = 0;
+    uint64_t format_events_ = 0;
+    bool overflow_ = false;
+    std::size_t max_queue_depth_ = 0;
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Runtime.cpp b/src/Phase1Runtime.cpp
new file mode 100644
index 0000000..ee096a7
--- /dev/null
+++ b/src/Phase1Runtime.cpp
@@ -0,0 +1,215 @@
+#include "Phase1Runtime.h"
+
+#include <stdexcept>
+
+namespace DRAMSim
+{
+const char* outputStateName(OutputState state)
+{
+    switch (state)
+    {
+        case OutputState::ALLOCATED: return "ALLOCATED";
+        case OutputState::PRODUCING: return "PRODUCING";
+        case OutputState::READY_UNPUBLISHED: return "READY_UNPUBLISHED";
+        case OutputState::PUBLISHED: return "PUBLISHED";
+        case OutputState::SUSPECT: return "SUSPECT";
+        case OutputState::QUIESCED: return "QUIESCED";
+        case OutputState::RESTORING: return "RESTORING";
+        case OutputState::REEXECUTING: return "REEXECUTING";
+        case OutputState::POISONED: return "POISONED";
+        case OutputState::ABORTED: return "ABORTED";
+    }
+    return "UNKNOWN";
+}
+
+Phase1Runtime::Phase1Runtime(uint64_t holdCycles) : hold_cycles_(holdCycles) {}
+
+Phase1Runtime::Version& Phase1Runtime::currentVersionRecord()
+{
+    return current_;
+}
+
+const Phase1Runtime::Version& Phase1Runtime::currentVersionRecord() const
+{
+    return current_;
+}
+
+bool Phase1Runtime::handleCurrent(OutputHandle handle) const
+{
+    return handle.valid && currentVersion_ != 0 && handle.version == currentVersion_;
+}
+
+OutputHandle Phase1Runtime::allocateOutput(uint64_t bytes, uint64_t cycle)
+{
+    current_ = Version();
+    current_.version = ++currentVersion_;
+    current_.bytes = bytes;
+    current_.state = OutputState::ALLOCATED;
+    current_.allocated_cycle = cycle;
+    publish_cycle_ = 0;
+    lock_cycle_ = 0;
+    producer_done_cycle_ = 0;
+    publish_ready_cycle_ = 0;
+    OutputHandle handle;
+    handle.version = currentVersion_;
+    handle.valid = true;
+    return handle;
+}
+
+void Phase1Runtime::beginProducing(OutputHandle handle, uint64_t cycle)
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    (void)cycle;
+    if (current_.state != OutputState::ALLOCATED)
+        throw std::logic_error("output version is not ALLOCATED");
+    current_.state = OutputState::PRODUCING;
+}
+
+void Phase1Runtime::producerComplete(OutputHandle handle, uint64_t cycle)
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    if (current_.state != OutputState::PRODUCING &&
+        current_.state != OutputState::READY_UNPUBLISHED &&
+        current_.state != OutputState::SUSPECT &&
+        current_.state != OutputState::POISONED &&
+        current_.state != OutputState::REEXECUTING)
+        throw std::logic_error("producer completion in invalid output state");
+    current_.producer_done_cycle = cycle;
+    current_.publish_ready_cycle = cycle + hold_cycles_;
+    producer_done_cycle_ = cycle;
+    publish_ready_cycle_ = current_.publish_ready_cycle;
+    if (current_.state == OutputState::PRODUCING ||
+        current_.state == OutputState::REEXECUTING)
+        current_.state = OutputState::READY_UNPUBLISHED;
+}
+
+void Phase1Runtime::quiesceOutput(OutputHandle handle, uint64_t cycle)
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    if (current_.state != OutputState::PRODUCING &&
+        current_.state != OutputState::SUSPECT &&
+        current_.state != OutputState::READY_UNPUBLISHED)
+        throw std::logic_error("output version is not quiescible");
+    (void)cycle;
+    current_.state = OutputState::QUIESCED;
+}
+
+void Phase1Runtime::beginRestore(OutputHandle handle, uint64_t cycle)
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    if (current_.state == OutputState::PUBLISHED)
+        throw std::logic_error("ALREADY_COMMITTED");
+    if (current_.state != OutputState::QUIESCED)
+        throw std::logic_error("output version is not QUIESCED");
+    (void)cycle;
+    current_.state = OutputState::RESTORING;
+}
+
+void Phase1Runtime::beginReexecute(OutputHandle handle, uint64_t cycle)
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    if (current_.state != OutputState::ALLOCATED &&
+        current_.state != OutputState::RESTORING)
+        throw std::logic_error("output version is not ready for re-execution");
+    (void)cycle;
+    current_.state = OutputState::REEXECUTING;
+}
+
+void Phase1Runtime::onReport(const Phase1PublicReport& report, uint64_t cycle)
+{
+    if (currentVersion_ == 0 || current_.state == OutputState::ABORTED)
+        return;
+    if (report.error_class != "CE" && report.error_class != "UE")
+        return;
+    if (current_.state == OutputState::PUBLISHED)
+    {
+        late_reports_++;
+        return;
+    }
+    if (current_.state == OutputState::POISONED)
+        return;
+    if (current_.state == OutputState::SUSPECT && report.error_class != "UE")
+        return;
+    if (report.error_class == "UE")
+    {
+        current_.state = OutputState::POISONED;
+    }
+    else
+    {
+        current_.state = OutputState::SUSPECT;
+    }
+    lock_cycle_ = cycle;
+    current_.lock_cycle = cycle;
+    lock_count_++;
+}
+
+void Phase1Runtime::tick(uint64_t cycle)
+{
+    if (currentVersion_ == 0)
+        return;
+    if (current_.state != OutputState::READY_UNPUBLISHED)
+        return;
+    if (cycle < current_.publish_ready_cycle)
+        return;
+    current_.state = OutputState::PUBLISHED;
+    current_.publish_cycle = cycle;
+    publish_cycle_ = cycle;
+}
+
+bool Phase1Runtime::canConsume(OutputHandle handle, ConsumerType consumer, uint64_t cycle) const
+{
+    (void)consumer;
+    (void)cycle;
+    return handleCurrent(handle) && current_.state == OutputState::PUBLISHED;
+}
+
+bool Phase1Runtime::canAdmit(OutputHandle handle, ConsumerType consumer, uint64_t cycle) const
+{
+    return canConsume(handle, consumer, cycle);
+}
+
+bool Phase1Runtime::consume(OutputHandle handle, ConsumerType consumer, uint64_t cycle)
+{
+    if (!canConsume(handle, consumer, cycle))
+    {
+        blocked_consumer_reads_++;
+        return false;
+    }
+    current_.consumed++;
+    consumed_reads_++;
+    return true;
+}
+
+void Phase1Runtime::assertConsumerAllowed(OutputHandle handle, ConsumerType consumer,
+                                          uint64_t cycle) const
+{
+    if (!handleCurrent(handle))
+        throw std::logic_error("STALE_HANDLE");
+    if (!canConsume(handle, consumer, cycle))
+        throw std::logic_error(std::string("UNPUBLISHED_OUTPUT:") +
+                               outputStateName(current_.state));
+}
+
+OutputState Phase1Runtime::state(OutputHandle handle) const
+{
+    if (!handleCurrent(handle))
+        return OutputState::ABORTED;
+    return current_.state;
+}
+
+bool Phase1Runtime::isStale(OutputHandle handle) const
+{
+    return !handleCurrent(handle);
+}
+
+bool Phase1Runtime::isPublished(OutputHandle handle) const
+{
+    return handleCurrent(handle) && current_.state == OutputState::PUBLISHED;
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Runtime.h b/src/Phase1Runtime.h
new file mode 100644
index 0000000..eb354a3
--- /dev/null
+++ b/src/Phase1Runtime.h
@@ -0,0 +1,110 @@
+#ifndef PHASE1_RUNTIME_H
+#define PHASE1_RUNTIME_H
+
+#include <cstdint>
+#include <string>
+
+#include "Phase1Reports.h"
+
+namespace DRAMSim
+{
+enum class OutputState
+{
+    ALLOCATED,
+    PRODUCING,
+    READY_UNPUBLISHED,
+    PUBLISHED,
+    SUSPECT,
+    QUIESCED,
+    RESTORING,
+    REEXECUTING,
+    POISONED,
+    ABORTED
+};
+
+enum class ConsumerType
+{
+    HOST,
+    PIM
+};
+
+struct OutputHandle
+{
+    uint64_t version = 0;
+    bool valid = false;
+};
+
+const char* outputStateName(OutputState state);
+
+// G5 output-version state machine and consumer admission gate.  It has no
+// reference to fault schedules, golden output or storage internals.  Pause,
+// quiesce and restore transitions are deliberately not implemented here.
+class Phase1Runtime
+{
+  public:
+    explicit Phase1Runtime(uint64_t holdCycles = 0);
+
+    OutputHandle allocateOutput(uint64_t bytes, uint64_t cycle);
+    void beginProducing(OutputHandle handle, uint64_t cycle);
+    void producerComplete(OutputHandle handle, uint64_t cycle);
+    void quiesceOutput(OutputHandle handle, uint64_t cycle);
+    void beginRestore(OutputHandle handle, uint64_t cycle);
+    void beginReexecute(OutputHandle handle, uint64_t cycle);
+    void onReport(const Phase1PublicReport& report, uint64_t cycle);
+    void tick(uint64_t cycle);
+
+    bool canConsume(OutputHandle handle, ConsumerType consumer, uint64_t cycle) const;
+    bool canAdmit(OutputHandle handle, ConsumerType consumer, uint64_t cycle) const;
+    bool consume(OutputHandle handle, ConsumerType consumer, uint64_t cycle);
+
+    // Fail-fast guard for test/evaluator bypass paths.  Normal host/PIM paths
+    // call canConsume/canAdmit before entering the storage model.
+    void assertConsumerAllowed(OutputHandle handle, ConsumerType consumer, uint64_t cycle) const;
+
+    OutputState state(OutputHandle handle) const;
+    bool isStale(OutputHandle handle) const;
+    bool isPublished(OutputHandle handle) const;
+
+    uint64_t currentVersion() const { return currentVersion_; }
+    uint64_t blockedConsumerReads() const { return blocked_consumer_reads_; }
+    uint64_t lateReports() const { return late_reports_; }
+    uint64_t lockCount() const { return lock_count_; }
+    uint64_t consumedReads() const { return consumed_reads_; }
+    uint64_t publishCycle() const { return publish_cycle_; }
+    uint64_t lockCycle() const { return lock_cycle_; }
+    uint64_t producerDoneCycle() const { return producer_done_cycle_; }
+    uint64_t publishReadyCycle() const { return publish_ready_cycle_; }
+
+  private:
+    struct Version
+    {
+        uint64_t version = 0;
+        uint64_t bytes = 0;
+        OutputState state = OutputState::ALLOCATED;
+        uint64_t allocated_cycle = 0;
+        uint64_t producer_done_cycle = 0;
+        uint64_t publish_ready_cycle = 0;
+        uint64_t publish_cycle = 0;
+        uint64_t lock_cycle = 0;
+        uint64_t consumed = 0;
+    };
+
+    Version& currentVersionRecord();
+    const Version& currentVersionRecord() const;
+    bool handleCurrent(OutputHandle handle) const;
+
+    uint64_t hold_cycles_ = 0;
+    uint64_t currentVersion_ = 0;
+    Version current_;
+    uint64_t blocked_consumer_reads_ = 0;
+    uint64_t late_reports_ = 0;
+    uint64_t lock_count_ = 0;
+    uint64_t consumed_reads_ = 0;
+    uint64_t publish_cycle_ = 0;
+    uint64_t lock_cycle_ = 0;
+    uint64_t producer_done_cycle_ = 0;
+    uint64_t publish_ready_cycle_ = 0;
+};
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Storage.cpp b/src/Phase1Storage.cpp
new file mode 100644
index 0000000..d82001f
--- /dev/null
+++ b/src/Phase1Storage.cpp
@@ -0,0 +1,97 @@
+#include "Phase1Storage.h"
+
+#include <sstream>
+#include <stdexcept>
+
+namespace DRAMSim
+{
+std::string phase1StorageKeyToString(const Phase1StorageKey& key)
+{
+    std::ostringstream os;
+    os << "ch=" << key.channel << ",rank=" << key.rank << ",bank=" << key.actual_bank
+       << ",row=" << key.row << ",burst_col=" << key.burst_column << ",cw=" << key.codeword_index;
+    return os.str();
+}
+
+const Phase1Storage::Entry& Phase1Storage::at(const Phase1StorageKey& key) const
+{
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    return found->second;
+}
+
+bool Phase1Storage::contains(const Phase1StorageKey& key) const
+{
+    return entries_.find(key) != entries_.end();
+}
+
+void Phase1Storage::initialize(const Phase1StorageKey& key, uint64_t data)
+{
+    Entry entry;
+    entry.data = data;
+    entry.parity = Phase1Ecc::encodeParity(data);
+    entry.ecc_valid = true;
+    entries_[key] = entry;
+}
+
+void Phase1Storage::writeLegal(const Phase1StorageKey& key, uint64_t data)
+{
+    initialize(key, data);
+}
+
+void Phase1Storage::writeUnprotected(const Phase1StorageKey& key, uint64_t data)
+{
+    Entry entry;
+    entry.data = data;
+    entry.parity = 0;
+    entry.ecc_valid = false;
+    entries_[key] = entry;
+}
+
+Phase1EccResult Phase1Storage::readProtected(const Phase1StorageKey& key) const
+{
+    const Entry& entry = at(key);
+    if (!entry.ecc_valid)
+    {
+        Phase1EccResult result;
+        result.data = entry.data;
+        result.status = Phase1EccStatus::UNPROTECTED_FORMAT;
+        result.syndrome = 0;
+        result.overall_parity = 0;
+        return result;
+    }
+    return Phase1Ecc::decode(entry.data, entry.parity);
+}
+
+uint64_t Phase1Storage::readRawData(const Phase1StorageKey& key) const
+{
+    return at(key).data;
+}
+
+uint8_t Phase1Storage::readRawParity(const Phase1StorageKey& key) const
+{
+    return at(key).parity;
+}
+
+void Phase1Storage::injectDataBit(const Phase1StorageKey& key, unsigned bit)
+{
+    if (bit >= 64)
+        throw std::out_of_range("Phase1Storage data bit must be in [0,63]");
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    found->second.data ^= (uint64_t(1) << bit);
+}
+
+void Phase1Storage::injectParityBit(const Phase1StorageKey& key, unsigned bit)
+{
+    if (bit >= 8)
+        throw std::out_of_range("Phase1Storage parity bit must be in [0,7]");
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    found->second.parity ^= static_cast<uint8_t>(1u << bit);
+}
+
+}  // namespace DRAMSim
