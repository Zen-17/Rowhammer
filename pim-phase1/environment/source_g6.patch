new file mode 100644
index 0000000..d82001f
--- /dev/null
+++ b/src/Phase1Storage.cpp
@@ -0,0 +1,97 @@
+#include "Phase1Storage.h"
+
+#include <sstream>
+#include <stdexcept>
+
+namespace DRAMSim
+{
+std::string phase1StorageKeyToString(const Phase1StorageKey& key)
+{
+    std::ostringstream os;
+    os << "ch=" << key.channel << ",rank=" << key.rank << ",bank=" << key.actual_bank
+       << ",row=" << key.row << ",burst_col=" << key.burst_column << ",cw=" << key.codeword_index;
+    return os.str();
+}
+
+const Phase1Storage::Entry& Phase1Storage::at(const Phase1StorageKey& key) const
+{
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    return found->second;
+}
+
+bool Phase1Storage::contains(const Phase1StorageKey& key) const
+{
+    return entries_.find(key) != entries_.end();
+}
+
+void Phase1Storage::initialize(const Phase1StorageKey& key, uint64_t data)
+{
+    Entry entry;
+    entry.data = data;
+    entry.parity = Phase1Ecc::encodeParity(data);
+    entry.ecc_valid = true;
+    entries_[key] = entry;
+}
+
+void Phase1Storage::writeLegal(const Phase1StorageKey& key, uint64_t data)
+{
+    initialize(key, data);
+}
+
+void Phase1Storage::writeUnprotected(const Phase1StorageKey& key, uint64_t data)
+{
+    Entry entry;
+    entry.data = data;
+    entry.parity = 0;
+    entry.ecc_valid = false;
+    entries_[key] = entry;
+}
+
+Phase1EccResult Phase1Storage::readProtected(const Phase1StorageKey& key) const
+{
+    const Entry& entry = at(key);
+    if (!entry.ecc_valid)
+    {
+        Phase1EccResult result;
+        result.data = entry.data;
+        result.status = Phase1EccStatus::UNPROTECTED_FORMAT;
+        result.syndrome = 0;
+        result.overall_parity = 0;
+        return result;
+    }
+    return Phase1Ecc::decode(entry.data, entry.parity);
+}
+
+uint64_t Phase1Storage::readRawData(const Phase1StorageKey& key) const
+{
+    return at(key).data;
+}
+
+uint8_t Phase1Storage::readRawParity(const Phase1StorageKey& key) const
+{
+    return at(key).parity;
+}
+
+void Phase1Storage::injectDataBit(const Phase1StorageKey& key, unsigned bit)
+{
+    if (bit >= 64)
+        throw std::out_of_range("Phase1Storage data bit must be in [0,63]");
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    found->second.data ^= (uint64_t(1) << bit);
+}
+
+void Phase1Storage::injectParityBit(const Phase1StorageKey& key, unsigned bit)
+{
+    if (bit >= 8)
+        throw std::out_of_range("Phase1Storage parity bit must be in [0,7]");
+    auto found = entries_.find(key);
+    if (found == entries_.end())
+        throw std::out_of_range("Phase1Storage key not initialized: " + phase1StorageKeyToString(key));
+    found->second.parity ^= static_cast<uint8_t>(1u << bit);
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Storage.h b/src/Phase1Storage.h
new file mode 100644
index 0000000..cdedd73
--- /dev/null
+++ b/src/Phase1Storage.h
@@ -0,0 +1,69 @@
+#ifndef PHASE1_STORAGE_H
+#define PHASE1_STORAGE_H
+
+#include <cstdint>
+#include <map>
+#include <string>
+
+#include "Phase1Ecc.h"
+
+namespace DRAMSim
+{
+// Stable storage identity for one 64-bit ECC codeword.  A 32 B burst has four
+// independent codewords; the caller supplies codeword_index 0..3.
+struct Phase1StorageKey
+{
+    unsigned channel = 0;
+    unsigned rank = 0;
+    unsigned actual_bank = 0;
+    unsigned row = 0;
+    unsigned burst_column = 0;
+    unsigned codeword_index = 0;
+
+    bool operator<(const Phase1StorageKey& rhs) const
+    {
+        if (channel != rhs.channel) return channel < rhs.channel;
+        if (rank != rhs.rank) return rank < rhs.rank;
+        if (actual_bank != rhs.actual_bank) return actual_bank < rhs.actual_bank;
+        if (row != rhs.row) return row < rhs.row;
+        if (burst_column != rhs.burst_column) return burst_column < rhs.burst_column;
+        return codeword_index < rhs.codeword_index;
+    }
+};
+
+std::string phase1StorageKeyToString(const Phase1StorageKey& key);
+
+// Research storage model with explicit raw data+parity metadata.  Reads do not
+// scrub; a persistent bit flip can therefore produce a CE on every read.
+// Mutation/raw-inspection methods are test/evaluator-only interfaces.
+class Phase1Storage
+{
+  public:
+    void initialize(const Phase1StorageKey& key, uint64_t data);
+    void writeLegal(const Phase1StorageKey& key, uint64_t data);
+    // PIM/HAB writeback in HOST_ONLY: raw data without a valid ECC format.
+    void writeUnprotected(const Phase1StorageKey& key, uint64_t data);
+    Phase1EccResult readProtected(const Phase1StorageKey& key) const;
+
+    bool contains(const Phase1StorageKey& key) const;
+    uint64_t readRawData(const Phase1StorageKey& key) const;
+    uint8_t readRawParity(const Phase1StorageKey& key) const;
+
+    // Test-only raw mutation.  These do not re-encode parity.
+    void injectDataBit(const Phase1StorageKey& key, unsigned bit);
+    void injectParityBit(const Phase1StorageKey& key, unsigned bit);
+
+  private:
+    struct Entry
+    {
+        uint64_t data = 0;
+        uint8_t parity = 0;
+        bool ecc_valid = false;
+    };
+
+    const Entry& at(const Phase1StorageKey& key) const;
+    std::map<Phase1StorageKey, Entry> entries_;
+};
+}  // namespace DRAMSim
+
+#endif
