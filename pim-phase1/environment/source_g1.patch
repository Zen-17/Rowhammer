diff --git a/src/Phase1Address.cpp b/src/Phase1Address.cpp
new file mode 100644
index 0000000..02cb9f6
--- /dev/null
+++ b/src/Phase1Address.cpp
@@ -0,0 +1,138 @@
+#include "Phase1Address.h"
+
+#include <sstream>
+#include <stdexcept>
+
+#include "SystemConfiguration.h"
+#include "Utils.h"
+
+namespace DRAMSim
+{
+bool Phase1Geometry::valid() const
+{
+    if (num_channels == 0 || num_ranks == 0 || num_banks == 0 || num_bank_groups == 0 ||
+        num_rows == 0 || num_cols == 0 || burst_length == 0 || jedec_data_bus_bits == 0)
+        return false;
+    if (!isPowerOfTwo(num_channels) || !isPowerOfTwo(num_ranks) || !isPowerOfTwo(num_banks) ||
+        !isPowerOfTwo(num_bank_groups) || !isPowerOfTwo(num_rows) || !isPowerOfTwo(num_cols) ||
+        !isPowerOfTwo(burst_length))
+        return false;
+    if (num_banks % num_bank_groups != 0)
+        return false;
+    if (num_cols % burst_length != 0)
+        return false;
+    if ((jedec_data_bus_bits % 8) != 0 || (burst_length * jedec_data_bus_bits) % 8 != 0)
+        return false;
+    if (num_bank_groups > num_banks)
+        return false;
+    return true;
+}
+
+Phase1Address::Phase1Address(const Phase1Geometry& geometry) : geometry_(geometry)
+{
+    if (!geometry_.valid())
+        throw std::invalid_argument("invalid Phase1Geometry");
+    deriveBitWidths();
+}
+
+uint64_t Phase1Address::mask(unsigned bits)
+{
+    if (bits == 0)
+        return 0;
+    if (bits >= 64)
+        return ~uint64_t(0);
+    return (uint64_t(1) << bits) - 1;
+}
+
+void Phase1Address::deriveBitWidths()
+{
+    channel_bits_ = uLog2(geometry_.num_channels);
+    rank_bits_ = uLog2(geometry_.num_ranks);
+    bank_bits_ = uLog2(geometry_.num_banks);
+    bankgroup_bits_ = uLog2(geometry_.num_bank_groups);
+    bank_within_group_bits_ = bank_bits_ - bankgroup_bits_;
+    row_bits_ = uLog2(geometry_.num_rows);
+    column_bits_ = uLog2(geometry_.num_cols / geometry_.burst_length);
+    offset_bits_ = uLog2(geometry_.burst_bytes());
+}
+
+bool Phase1Address::inRange(const Phase1AddrTuple& tuple) const
+{
+    if (tuple.channel >= geometry_.num_channels || tuple.rank >= geometry_.num_ranks ||
+        tuple.bank >= geometry_.num_banks || tuple.row >= geometry_.num_rows ||
+        tuple.burst_column >= geometry_.burst_columns())
+        return false;
+    return true;
+}
+
+uint64_t Phase1Address::encode(const Phase1AddrTuple& tuple) const
+{
+    if (!inRange(tuple))
+        throw std::out_of_range("Phase1AddrTuple outside geometry");
+    const unsigned bank_within_group = tuple.bank & ((1u << bank_within_group_bits_) - 1u);
+    const unsigned bank_group = tuple.bank >> bank_within_group_bits_;
+
+    uint64_t address = tuple.rank & mask(rank_bits_);
+    address = (address << row_bits_) | (tuple.row & mask(row_bits_));
+    address = (address << column_bits_) | (tuple.burst_column & mask(column_bits_));
+    address = (address << bankgroup_bits_) | (bank_group & mask(bankgroup_bits_));
+    address = (address << bank_within_group_bits_) | bank_within_group;
+    address = (address << channel_bits_) | (tuple.channel & mask(channel_bits_));
+    address = (address << offset_bits_);
+    return address;
+}
+
+Phase1AddrTuple Phase1Address::decode(uint64_t address) const
+{
+    Phase1AddrTuple tuple;
+    uint64_t value = address;
+    const uint64_t offset = value & mask(offset_bits_);
+    value >>= offset_bits_;
+    tuple.channel = static_cast<unsigned>(value & mask(channel_bits_));
+    value >>= channel_bits_;
+    const unsigned bank_within_group = static_cast<unsigned>(value & mask(bank_within_group_bits_));
+    value >>= bank_within_group_bits_;
+    const unsigned bank_group = static_cast<unsigned>(value & mask(bankgroup_bits_));
+    value >>= bankgroup_bits_;
+    tuple.burst_column = static_cast<unsigned>(value & mask(column_bits_));
+    value >>= column_bits_;
+    tuple.row = static_cast<unsigned>(value & mask(row_bits_));
+    value >>= row_bits_;
+    tuple.rank = static_cast<unsigned>(value & mask(rank_bits_));
+    value >>= rank_bits_;
+    tuple.bank = (bank_group << bank_within_group_bits_) | bank_within_group;
+    if (offset != 0 || value != 0)
+        throw std::out_of_range("Phase1 address has non-zero offset or high bits");
+    return tuple;
+}
+
+uint64_t Phase1Address::addressMask() const
+{
+    const unsigned total_bits = channel_bits_ + rank_bits_ + bank_bits_ + row_bits_ +
+                                column_bits_ + offset_bits_;
+    return mask(total_bits);
+}
+
+Phase1Geometry Phase1Address::fromConfiguration()
+{
+    Phase1Geometry geometry;
+    geometry.num_channels = getConfigParam(UINT, "NUM_CHANS");
+    geometry.num_ranks = getConfigParam(UINT, "NUM_RANKS");
+    geometry.num_banks = getConfigParam(UINT, "NUM_BANKS");
+    geometry.num_bank_groups = getConfigParam(UINT, "NUM_BANK_GROUPS");
+    geometry.num_rows = getConfigParam(UINT, "NUM_ROWS");
+    geometry.num_cols = getConfigParam(UINT, "NUM_COLS");
+    geometry.burst_length = getConfigParam(UINT, "BL");
+    geometry.jedec_data_bus_bits = getConfigParam(UINT, "JEDEC_DATA_BUS_BITS");
+    return geometry;
+}
+
+std::string phase1AddrToString(const Phase1AddrTuple& tuple)
+{
+    std::ostringstream os;
+    os << "ch=" << tuple.channel << ",rank=" << tuple.rank << ",bank=" << tuple.bank
+       << ",row=" << tuple.row << ",burst_col=" << tuple.burst_column;
+    return os.str();
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Address.h b/src/Phase1Address.h
new file mode 100644
index 0000000..fc4bdf9
--- /dev/null
+++ b/src/Phase1Address.h
@@ -0,0 +1,83 @@
+#ifndef PHASE1_ADDRESS_H
+#define PHASE1_ADDRESS_H
+
+#include <cstdint>
+#include <string>
+
+namespace DRAMSim
+{
+// A Scheme8 address tuple.  The column is the 32 B burst-column index used by
+// BusPacket/Bank, not the raw JEDEC column.
+struct Phase1AddrTuple
+{
+    unsigned channel = 0;
+    unsigned rank = 0;
+    unsigned bank = 0;
+    unsigned row = 0;
+    unsigned burst_column = 0;
+
+    bool operator==(const Phase1AddrTuple& rhs) const
+    {
+        return channel == rhs.channel && rank == rhs.rank && bank == rhs.bank && row == rhs.row &&
+               burst_column == rhs.burst_column;
+    }
+    bool operator!=(const Phase1AddrTuple& rhs) const { return !(*this == rhs); }
+};
+
+struct Phase1Geometry
+{
+    unsigned num_channels = 0;
+    unsigned num_ranks = 0;
+    unsigned num_banks = 0;
+    unsigned num_bank_groups = 0;
+    unsigned num_rows = 0;
+    unsigned num_cols = 0;
+    unsigned burst_length = 0;
+    unsigned jedec_data_bus_bits = 0;
+
+    unsigned burst_bytes() const { return burst_length * jedec_data_bus_bits / 8; }
+    unsigned burst_columns() const { return num_cols / burst_length; }
+    bool valid() const;
+};
+
+// Encode/decode the fixed upstream Scheme8 layout used by PIMAddrManager:
+// rank:row:col:bg:bank_within_group:channel:byte_offset.
+//
+// This is a Phase1 test/address utility.  It is an explicit model-side
+// assumption, not a claim that the upstream simulator exposes a general
+// tuple->address API.  Round-trip tests compare it with the upstream
+// AddrMapping::addressMapping decoder.
+class Phase1Address
+{
+  public:
+    explicit Phase1Address(const Phase1Geometry& geometry);
+
+    uint64_t encode(const Phase1AddrTuple& tuple) const;
+    Phase1AddrTuple decode(uint64_t address) const;
+    bool inRange(const Phase1AddrTuple& tuple) const;
+
+    const Phase1Geometry& geometry() const { return geometry_; }
+    uint64_t addressMask() const;
+
+    static Phase1Geometry fromConfiguration();
+
+  private:
+    Phase1Geometry geometry_;
+    unsigned channel_bits_ = 0;
+    unsigned rank_bits_ = 0;
+    unsigned bank_bits_ = 0;
+    unsigned bankgroup_bits_ = 0;
+    unsigned bank_within_group_bits_ = 0;
+    unsigned row_bits_ = 0;
+    unsigned column_bits_ = 0;
+    unsigned offset_bits_ = 0;
+
+    static uint64_t mask(unsigned bits);
+    void deriveBitWidths();
+};
+
+std::string phase1AddrToString(const Phase1AddrTuple& tuple);
+
+}  // namespace DRAMSim
+
+#endif
diff --git a/src/Phase1Driver.cpp b/src/Phase1Driver.cpp
new file mode 100644
index 0000000..add8f6f
--- /dev/null
+++ b/src/Phase1Driver.cpp
@@ -0,0 +1,197 @@
+#include "Phase1Driver.h"
+
+#include <algorithm>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <unordered_set>
+
+#include "Utils.h"
+
+namespace DRAMSim
+{
+namespace
+{
+std::string trim(const std::string& input)
+{
+    const std::string whitespace = " \t\r\n";
+    const std::size_t first = input.find_first_not_of(whitespace);
+    if (first == std::string::npos)
+        return "";
+    const std::size_t last = input.find_last_not_of(whitespace);
+    return input.substr(first, last - first + 1);
+}
+
+unsigned parseUnsigned(const std::string& key, const std::string& value)
+{
+    try
+    {
+        std::size_t consumed = 0;
+        const unsigned long parsed = std::stoul(value, &consumed);
+        if (consumed != value.size())
+            throw std::invalid_argument("trailing characters");
+        return static_cast<unsigned>(parsed);
+    }
+    catch (const std::exception&)
+    {
+        throw std::runtime_error("invalid unsigned parameter " + key + "=" + value);
+    }
+}
+
+uint64_t parseUint64(const std::string& key, const std::string& value)
+{
+    try
+    {
+        std::size_t consumed = 0;
+        const unsigned long long parsed = std::stoull(value, &consumed);
+        if (consumed != value.size())
+            throw std::invalid_argument("trailing characters");
+        return static_cast<uint64_t>(parsed);
+    }
+    catch (const std::exception&)
+    {
+        throw std::runtime_error("invalid uint64 parameter " + key + "=" + value);
+    }
+}
+}  // namespace
+
+Phase1RunConfig loadPhase1Config(const std::string& path)
+{
+    std::ifstream input(path);
+    if (!input)
+        throw std::runtime_error("cannot open Phase1 config: " + path);
+
+    std::map<std::string, std::string> values;
+    static const std::unordered_set<std::string> allowed = {
+        "schema_version", "experiment", "workload", "mode", "device_ini", "system_ini",
+        "channels", "ranks", "capacity_mb", "n_tiles", "seed", "feeder_outstanding_limit",
+        "feeder_issue_per_cycle", "watchdog_cycles", "dim_bursts", "elements", "output_dir"};
+    std::string line;
+    unsigned lineNumber = 0;
+    while (std::getline(input, line))
+    {
+        lineNumber++;
+        line = trim(line);
+        if (line.empty() || line[0] == ';' || line[0] == '#')
+            continue;
+        const std::size_t equal = line.find('=');
+        if (equal == std::string::npos)
+            throw std::runtime_error("malformed Phase1 config line " + std::to_string(lineNumber));
+        const std::string key = trim(line.substr(0, equal));
+        const std::string value = trim(line.substr(equal + 1));
+        if (allowed.count(key) == 0)
+            throw std::runtime_error("unknown Phase1 config key: " + key);
+        values[key] = value;
+    }
+
+    auto require = [&](const std::string& key) -> const std::string& {
+        auto it = values.find(key);
+        if (it == values.end())
+            throw std::runtime_error("missing Phase1 config key: " + key);
+        return it->second;
+    };
+
+    Phase1RunConfig config;
+    config.experiment = require("experiment");
+    config.workload = require("workload");
+    config.mode = require("mode");
+    config.device_ini = require("device_ini");
+    config.system_ini = require("system_ini");
+    config.channels = parseUnsigned("channels", require("channels"));
+    config.ranks = parseUnsigned("ranks", require("ranks"));
+    config.capacity_mb = parseUnsigned("capacity_mb", require("capacity_mb"));
+    config.n_tiles = parseUnsigned("n_tiles", require("n_tiles"));
+    config.seed = parseUnsigned("seed", require("seed"));
+    config.feeder_outstanding_limit =
+        parseUnsigned("feeder_outstanding_limit", require("feeder_outstanding_limit"));
+    config.feeder_issue_per_cycle =
+        parseUnsigned("feeder_issue_per_cycle", require("feeder_issue_per_cycle"));
+    config.watchdog_cycles = parseUint64("watchdog_cycles", require("watchdog_cycles"));
+
+    if (config.mode != "direct" && config.mode != "feeder")
+        throw std::runtime_error("mode must be direct or feeder");
+    if (config.workload != "W0" && config.workload != "W1" && config.workload != "ADDRESS")
+        throw std::runtime_error("workload must be W0, W1, or ADDRESS");
+    if (config.channels != 1 && config.channels != 2)
+        throw std::runtime_error("G1 supports only 1 or 2 channels");
+    if (config.ranks != 1)
+        throw std::runtime_error("G1 supports exactly 1 rank per channel");
+    if (config.feeder_issue_per_cycle != 1)
+        throw std::runtime_error("G1 feeder issue rate must be 1");
+    if (config.watchdog_cycles == 0)
+        throw std::runtime_error("watchdog_cycles must be non-zero");
+    if (config.workload == "W1" && config.n_tiles != 1 && config.n_tiles != 8)
+        throw std::runtime_error("G1 W1 requires n_tiles 1 or 8");
+
+    return config;
+}
+
+bool Phase1Driver::directIdle(const MultiChannelMemorySystem& memory)
+{
+    if (memory.hasPendingTransactions() != 0)
+        return false;
+    for (const MemorySystem* channel : memory.channels)
+    {
+        if (channel == nullptr || !channel->pendingTransactions.empty())
+            return false;
+        if (channel->memoryController == nullptr ||
+            !channel->memoryController->transactionQueue.empty())
+            return false;
+        if (channel->ranks == nullptr)
+            return false;
+        for (const Rank* rank : *channel->ranks)
+        {
+            if (rank == nullptr || rank->outgoingDataPacket != nullptr ||
+                !rank->readReturnPacket.empty() || !rank->readReturnCountdown.empty())
+                return false;
+        }
+    }
+    return true;
+}
+
+Phase1RunStats Phase1Driver::runDirect(MultiChannelMemorySystem& memory, uint64_t watchdogCycles)
+{
+    Phase1RunStats stats;
+    while (!directIdle(memory))
+    {
+        if (stats.updates >= watchdogCycles)
+        {
+            stats.timeout = true;
+            break;
+        }
+        memory.update();
+        stats.updates++;
+        stats.cycles = stats.updates;
+    }
+    for (const MemorySystem* channel : memory.channels)
+        if (channel != nullptr)
+            stats.pending_at_end += channel->pendingTransactions.size();
+    return stats;
+}
+
+Phase1RunStats Phase1Driver::runFeeder(Phase1FeederMemory& memory, uint64_t watchdogCycles)
+{
+    Phase1RunStats stats;
+    stats.feeder_used = true;
+    while (!memory.isIdle())
+    {
+        if (stats.updates >= watchdogCycles)
+        {
+            stats.timeout = true;
+            break;
+        }
+        memory.tick();
+        memory.update();
+        stats.updates++;
+        stats.cycles = stats.updates;
+    }
+    stats.pending_at_end = memory.pendingCount();
+    stats.outstanding_at_end = memory.outstandingCount();
+    stats.max_external_pending = memory.maxPending();
+    stats.max_accepted_outstanding = memory.maxOutstanding();
+    stats.controller_rejections = memory.controllerRejections();
+    stats.barriers_retired = memory.barriersRetired();
+    return stats;
+}
+
+}  // namespace DRAMSim
diff --git a/src/Phase1Driver.h b/src/Phase1Driver.h
new file mode 100644
